# Supabase production configuration (Ukeplanen 2.1)
# These are PUBLIC browser-side credentials. Never use the secret/service_role key!
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase Auth -> Email OTP template must contain {{ .Token }}.
# Supabase -> URL Configuration -> Site URL https://ukeplanen.netlify.app
# Redirect allowlist should include exact production domain and opted-in deploy previews.
# Before enabling, apply supabase/migrations/20261029_family_accounts.sql
# to an isolated Supabase project and run the RLS manual acceptance tests.
